# Confluence 6.6.17 (Enterprise release, 2019-11-06).
# Facts and how they were verified: docs/notes/hosts.md
PRODUCT=confluence
VERSION=6.6.17
ARCHIVE_URL=https://product-downloads.atlassian.com/software/confluence/downloads/atlassian-confluence-6.6.17.tar.gz
ARCHIVE_MD5=61381a93de0e341f1fc08fd9b9b40bae

# Supported (Supported Platforms page for 6.6): Java 1.8 (Oracle), AdoptOpenJDK 8 from 6.6.12.
# PostgreSQL 9.2 - 9.6.
JAVA_MAJOR=8
JAVA_IMAGE=eclipse-temurin:8-jdk
DB_TYPE=postgres
DB_IMAGE=postgres:9.6
DB_PORT=5436
DB_NAME=confluence
DB_USER=confluence
DB_PASSWORD=confluence

HTTP_PORT=8066
CONTEXT_PATH=
JVM_MIN_MEM=1024m
JVM_MAX_MEM=2048m
EXTRA_JVM_OPTS="-Dupm.plugin.upload.enabled=true"

# Names of the variables in .env.local that hold the licences (never the keys themselves).
LICENSE_ENV_VAR=ATL_LICENSE_CONFLUENCE_DC
APP_LICENSE_ENV_VAR=ATL_LICENSE_APP_DC

# Wizard flow used by env/setup (see env/setup/wizards/).
SETUP_WIZARD=confluence-6

APP_KEY=org.techtime.confluence.plugins.easysso
APP_FILES="apps/confluence.plugins.easysso-5.2.4.obr"
