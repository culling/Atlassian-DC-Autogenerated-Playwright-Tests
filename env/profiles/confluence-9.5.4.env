# Confluence Data Center 9.5.4 (2025-09-03): the newest Confluence 9 release, and the newest host
# that EasySSO 5.2.4 supports (6.0.1 - 9.5.4). Facts and how they were verified: docs/notes/hosts.md
PRODUCT=confluence
VERSION=9.5.4
ARCHIVE_URL=https://product-downloads.atlassian.com/software/confluence/downloads/atlassian-confluence-9.5.4.tar.gz
ARCHIVE_MD5=42f01c1fc1eca5c5f585bc8a3a4eefa4

# Supported (Supported Platforms page for 9.5): Java 21 (Java 17 deprecated). PostgreSQL 16 (15 deprecated).
JAVA_MAJOR=21
JAVA_IMAGE=eclipse-temurin:21-jdk
DB_TYPE=postgres
DB_IMAGE=postgres:16
DB_PORT=5437
DB_NAME=confluence
DB_USER=confluence
DB_PASSWORD=confluence

# Different ports from confluence-6.6.17 and from the _reference profiles, so all can run at the same time.
HTTP_PORT=8095
CONTEXT_PATH=
JVM_MIN_MEM=1024m
JVM_MAX_MEM=2048m
# upm.plugin.upload.enabled: Confluence 8.8+ refuses app upload through UPM by default.
EXTRA_JVM_OPTS="-Dupm.plugin.upload.enabled=true"

# Names of the variables in .env.local that hold the licences (never the keys themselves).
LICENSE_ENV_VAR=ATL_LICENSE_CONFLUENCE_DC
APP_LICENSE_ENV_VAR=ATL_LICENSE_APP_DC

# Wizard flow used by env/setup (see env/setup/wizards/).
SETUP_WIZARD=confluence-9

APP_KEY=org.techtime.confluence.plugins.easysso
APP_FILES="apps/confluence.plugins.easysso-5.2.4.obr"
