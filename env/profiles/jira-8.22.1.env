# Jira Software Data Center 8.22.1. Released 2022-03-16; the earliest host for EasySSO for Jira 5.2.4 (8.22.0 - 10.7.4) that the user asked for.
# Facts and how they were verified: docs/notes/hosts.md
PRODUCT=jira
VERSION=8.22.1
ARCHIVE_URL=https://product-downloads.atlassian.com/software/jira/downloads/atlassian-jira-software-8.22.1.tar.gz
ARCHIVE_MD5=cd0c05ae7e6fe6b9390b82e132de7e06

# Supported (Supported platforms page for 8.22): Java 8 and 11 (Oracle, Temurin). PostgreSQL 10 - 13.
JAVA_MAJOR=11
JAVA_IMAGE=eclipse-temurin:11-jdk
DB_TYPE=postgres
DB_IMAGE=postgres:13
DB_PORT=5438
DB_NAME=jira
DB_USER=jira
DB_PASSWORD=jira

# Different ports from every other profile (here and in _reference), so all can run at the same time.
HTTP_PORT=8822
CONTEXT_PATH=
JVM_MIN_MEM=1024m
JVM_MAX_MEM=2048m
# upm.plugin.upload.enabled: newer hosts refuse app upload through UPM by default.
# atlassian.darkfeature.jira.onboarding.feature.disabled: no "Welcome to Jira" flow for new users (see JiraWizard).
EXTRA_JVM_OPTS="-Dupm.plugin.upload.enabled=true -Datlassian.darkfeature.jira.onboarding.feature.disabled=true"

# Names of the variables in .env.local that hold the licences (never the keys themselves).
LICENSE_ENV_VAR=ATL_LICENSE_JIRA_DC
APP_LICENSE_ENV_VAR=ATL_LICENSE_APP_DC

# Wizard flow used by env/setup (see env/setup/wizards/).
SETUP_WIZARD=jira

APP_KEY=org.techtime.jira.plugins.easysso
APP_FILES="apps/jira.plugins.easysso-5.2.4.obr"
