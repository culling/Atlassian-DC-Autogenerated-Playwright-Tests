# Copy this file to .env.local (git-ignored) and fill in the values.
# Format: KEY=value, one per line, no spaces around "=". Read by env/atl-env.sh and by Playwright.

# Admin user created by the setup wizard and used by the tests.
ATL_ADMIN_USER=admin
ATL_ADMIN_PASSWORD=admin

# Host licence: "10 user Confluence Data Center license, expires in 3 hours" from
# https://developer.atlassian.com/platform/marketplace/timebomb-licenses-for-testing-server-apps/
# Paste the key on one line with the line breaks removed.
ATL_LICENSE_CONFLUENCE_DC=

# App licence: "10 user Data Center app license, expires in 3 hours" from the same page.
ATL_LICENSE_APP_DC=

# Jira host licence: "10 user Jira Software Data Center license, expires in 3 hours" from the same page.
ATL_LICENSE_JIRA_DC=
