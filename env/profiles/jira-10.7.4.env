# Jira Software Data Center 10.7.4. Released 2025-08-14; the newest host for EasySSO for Jira 5.2.4 (8.22.0 - 10.7.4).
# Facts and how they were verified: docs/notes/hosts.md
PRODUCT=jira
VERSION=10.7.4
ARCHIVE_URL=https://product-downloads.atlassian.com/software/jira/downloads/atlassian-jira-software-10.7.4.tar.gz
ARCHIVE_MD5=92cc9140f934b75fef9d0768e6a3b66d

# Supported (Supported platforms page for 10.7): Java 21 (17 deprecated). PostgreSQL 16 (12 - 15 deprecated).
JAVA_MAJOR=21
JAVA_IMAGE=eclipse-temurin:21-jdk
DB_TYPE=postgres
DB_IMAGE=postgres:16
DB_PORT=5439
DB_NAME=jira
DB_USER=jira
DB_PASSWORD=jira

# Different ports from every other profile (here and in _reference), so all can run at the same time.
HTTP_PORT=8107
CONTEXT_PATH=
JVM_MIN_MEM=1024m
JVM_MAX_MEM=2048m
# upm.plugin.upload.enabled: newer hosts refuse app upload through UPM by default.
# atlassian.darkfeature.jira.onboarding.feature.disabled: no "Welcome to Jira" flow for new users (see Jira10Wizard).
EXTRA_JVM_OPTS="-Dupm.plugin.upload.enabled=true -Datlassian.darkfeature.jira.onboarding.feature.disabled=true"

# Names of the variables in .env.local that hold the licences (never the keys themselves).
LICENSE_ENV_VAR=ATL_LICENSE_JIRA_DC
APP_LICENSE_ENV_VAR=ATL_LICENSE_APP_DC

# Wizard flow used by env/setup (see env/setup/wizards/).
SETUP_WIZARD=jira-10

APP_KEY=org.techtime.jira.plugins.easysso
APP_FILES="apps/jira.plugins.easysso-5.2.4.obr"
