# Confluence Data Center 8.5.31 (Long Term Support release).
# Facts and how they were verified: docs/notes/hosts.md
PRODUCT=confluence
VERSION=8.5.31
ARCHIVE_URL=https://product-downloads.atlassian.com/software/confluence/downloads/atlassian-confluence-8.5.31.tar.gz
ARCHIVE_MD5=9f9ab24413d649840f3959be21ebb119

# Supported: Java 11 and 17 (Temurin). PostgreSQL 12, 13, 14.
JAVA_MAJOR=17
JAVA_IMAGE=eclipse-temurin:17-jdk
DB_TYPE=postgres
DB_IMAGE=postgres:14
DB_PORT=5433
DB_NAME=confluence
DB_USER=confluence
DB_PASSWORD=confluence

HTTP_PORT=8090
CONTEXT_PATH=
JVM_MIN_MEM=1024m
JVM_MAX_MEM=2048m
# Extra Java system properties. upm.plugin.upload.enabled: Confluence 8 refuses app upload
# through UPM by default ("Plugins cannot be installed via upload").
EXTRA_JVM_OPTS="-Dupm.plugin.upload.enabled=true"

# Names of the variables in .env.local that hold the licences (never the keys themselves).
LICENSE_ENV_VAR=ATL_LICENSE_CONFLUENCE_DC
APP_LICENSE_ENV_VAR=ATL_LICENSE_APP_DC

# Wizard flow used by env/setup (see env/setup/wizards/).
SETUP_WIZARD=confluence-8

APP_KEY=org.techtime.confluence.plugins.googlemapsembed
APP_FILES="apps/confluence.plugins.googlemapsembed-8.1.5.obr"
