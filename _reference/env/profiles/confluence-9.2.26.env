# Confluence Data Center 9.2.26 (9.2 is a Long Term Support release; Data Center licences only).
# Facts and how they were verified: docs/notes/hosts.md
PRODUCT=confluence
VERSION=9.2.26
ARCHIVE_URL=https://product-downloads.atlassian.com/software/confluence/downloads/atlassian-confluence-9.2.26.tar.gz
ARCHIVE_MD5=533126e02b457711cc92d5ad2badba7d

# Supported: Java 17 and 21 (Temurin). PostgreSQL 15, 16 (14 deprecated).
JAVA_MAJOR=17
JAVA_IMAGE=eclipse-temurin:17-jdk
DB_TYPE=postgres
DB_IMAGE=postgres:16
DB_PORT=5434
DB_NAME=confluence
DB_USER=confluence
DB_PASSWORD=confluence

# Different ports from confluence-8.5.31, so both instances can run at the same time.
HTTP_PORT=8100
CONTEXT_PATH=
JVM_MIN_MEM=1024m
JVM_MAX_MEM=2048m
# Extra Java system properties. upm.plugin.upload.enabled: Confluence 8.8+ refuses app upload
# through UPM by default ("Plugins cannot be installed via upload").
EXTRA_JVM_OPTS="-Dupm.plugin.upload.enabled=true"

# Names of the variables in .env.local that hold the licences (never the keys themselves).
LICENSE_ENV_VAR=ATL_LICENSE_CONFLUENCE_DC
APP_LICENSE_ENV_VAR=ATL_LICENSE_APP_DC

# Wizard flow used by env/setup (see env/setup/wizards/).
SETUP_WIZARD=confluence-9

APP_KEY=org.techtime.confluence.plugins.googlemapsembed
APP_FILES="apps/confluence.plugins.googlemapsembed-8.1.5.obr"
